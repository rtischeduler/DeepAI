<script type="importmap">
{
    "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js"
    }
}
</script>
<script>
(function() {
    var dolphin3d = null;   // initialized on first click
    var loading = false;

    var logoLink = document.querySelector('.logo-link');
    if (!logoLink) return;

    logoLink.addEventListener('click', function(e) {
        if (window.location.pathname !== '/') return;
        e.preventDefault();

        // Already loaded — just toggle
        if (dolphin3d) { dolphin3d.toggle(); return; }

        // Prevent double-click while loading
        if (loading) return;
        loading = true;

        // Dynamic import — downloads Three.js + dolphin modules only now
        Promise.all([
            import('three'),
            import('/static/js/dolphin/vehicle.js'),
            import('/static/js/dolphin/dolphin.js')
        ]).then(function(modules) {
            var THREE = modules[0];
            var Vehicle = modules[1].Vehicle;
            var createDolphin = modules[2].createDolphin;

            dolphin3d = initDolphin3D(THREE, Vehicle, createDolphin);
            dolphin3d.toggle();
        });
    });

    function initDolphin3D(THREE, Vehicle, createDolphin) {
        // Renderer
        var renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setClearColor(0x000000, 0);
        renderer.domElement.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9999;pointer-events:none;display:none;';
        document.body.appendChild(renderer.domElement);

        // Scene & Camera
        var scene = new THREE.Scene();
        var camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.z = 10;

        // Lighting
        scene.add(new THREE.AmbientLight(0x6699bb, 0.6));
        var dirLight = new THREE.DirectionalLight(0xffffff, 1.4);
        dirLight.position.set(3, 4, 5);
        scene.add(dirLight);
        var fillLight = new THREE.DirectionalLight(0x0066dd, 0.4);
        fillLight.position.set(-2, -3, 3);
        scene.add(fillLight);
        var rimLight = new THREE.DirectionalLight(0x00aaff, 0.3);
        rimLight.position.set(0, 2, -3);
        scene.add(rimLight);

        // Dolphin model
        var result = createDolphin();
        var dolphinGroup = result.group;
        var animateDolphin = result.animate;
        dolphinGroup.scale.setScalar(0);
        scene.add(dolphinGroup);

        // Vehicle physics
        var vehicle = new Vehicle();

        // State
        var dolphinEnabled = false;
        var currentScale = 0;
        var targetScale = 0;
        var mouse = new THREE.Vector2(0, 0);
        var smoothMouse = new THREE.Vector2(0, 0);
        var dolphinPos = new THREE.Vector2(0, 0);

        var behavior = 'follow';
        var idleTime = 0;
        var circleAngle = 0;
        var circleStartAngle = 0;
        var CIRCLE_RADIUS = 0.25;
        var CIRCLE_SPEED = 0.6;

        var exploreTarget = new THREE.Vector2(0, 0);
        var exploreTimer = 0;
        var lastMouseX = 0, lastMouseY = 0;
        var mouseMoveAccum = 0;

        function pickExploreTarget() {
            exploreTarget.set((Math.random() - 0.5) * 1.2, (Math.random() - 0.5) * 1.2);
            exploreTimer = 0;
        }

        // Bubble particles
        var BUBBLE_N = 50;
        var BUBBLE_LIFETIME = 5.0;
        var bubblePos = new Float32Array(BUBBLE_N * 3);
        var bubbleLife = new Float32Array(BUBBLE_N);
        var bubbleSizes = new Float32Array(BUBBLE_N);
        for (var i = 0; i < BUBBLE_N; i++) {
            bubblePos[i*3] = bubblePos[i*3+1] = bubblePos[i*3+2] = 0;
            bubbleLife[i] = Math.random() * BUBBLE_LIFETIME * 0.8;
            bubbleSizes[i] = 0;
        }
        var bubbleGeo = new THREE.BufferGeometry();
        bubbleGeo.setAttribute('position', new THREE.BufferAttribute(bubblePos, 3));
        bubbleGeo.setAttribute('aSize', new THREE.BufferAttribute(bubbleSizes, 1));

        var bubbleShader = new THREE.ShaderMaterial({
            transparent: true,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
            uniforms: { uScale: { value: window.innerHeight } },
            vertexShader: 'attribute float aSize;varying float vAlpha;uniform float uScale;void main(){vAlpha=aSize;vec4 mv=modelViewMatrix*vec4(position,1.0);gl_PointSize=aSize*uScale*0.04/-mv.z;gl_Position=projectionMatrix*mv;}',
            fragmentShader: 'varying float vAlpha;void main(){float d=length(gl_PointCoord-0.5)*2.0;if(d>1.0)discard;float soft=1.0-d*d;gl_FragColor=vec4(0.55,0.82,1.0,soft*vAlpha*0.6);}',
        });
        scene.add(new THREE.Points(bubbleGeo, bubbleShader));

        function resetBubble(i) {
            var blowhole = new THREE.Vector3(0, 0.06, 0.55);
            dolphinGroup.localToWorld(blowhole);
            bubblePos[i*3] = blowhole.x + (Math.random()-0.5)*0.04;
            bubblePos[i*3+1] = blowhole.y + (Math.random()-0.5)*0.04;
            bubblePos[i*3+2] = blowhole.z + (Math.random()-0.5)*0.04;
            bubbleLife[i] = 0;
        }

        function getVisibleHalfSize() {
            var vFov = camera.fov * Math.PI / 180;
            var halfH = Math.tan(vFov / 2) * camera.position.z;
            return { halfW: halfH * camera.aspect, halfH: halfH };
        }

        // Animation loop
        var clock = new THREE.Clock();
        function animateLoop() {
            requestAnimationFrame(animateLoop);
            var dt = Math.min(clock.getDelta(), 0.05);

            currentScale += (targetScale - currentScale) * (1 - Math.exp(-8 * dt));
            if (currentScale < 0.005 && targetScale === 0) {
                currentScale = 0;
                renderer.domElement.style.display = 'none';
                return;
            }
            renderer.domElement.style.display = 'block';

            var vis = getVisibleHalfSize();
            var halfW = vis.halfW, halfH = vis.halfH;

            var f1 = 1 - Math.exp(-4 * dt);
            smoothMouse.x += (mouse.x - smoothMouse.x) * f1;
            smoothMouse.y += (mouse.y - smoothMouse.y) * f1;

            var mouseDx = mouse.x - lastMouseX;
            var mouseDy = mouse.y - lastMouseY;
            mouseMoveAccum = mouseMoveAccum * 0.9 + Math.sqrt(mouseDx * mouseDx + mouseDy * mouseDy);
            lastMouseX = mouse.x;
            lastMouseY = mouse.y;

            var vehNdcX = vehicle.pos.x / halfW;
            var vehNdcY = vehicle.pos.y / halfH;
            var distToMouse = Math.sqrt(Math.pow(vehNdcX - smoothMouse.x, 2) + Math.pow(vehNdcY - smoothMouse.y, 2));

            if (behavior === 'follow') {
                if (distToMouse < 0.1 && mouseMoveAccum < 0.003) {
                    idleTime += dt;
                    if (idleTime > 0.8) {
                        behavior = 'circle';
                        circleStartAngle = Math.atan2(dolphinPos.y - smoothMouse.y, dolphinPos.x - smoothMouse.x);
                        circleAngle = circleStartAngle;
                        idleTime = 0;
                    }
                } else { idleTime = 0; }
            } else if (behavior === 'circle') {
                if (mouseMoveAccum > 0.008) { behavior = 'follow'; idleTime = 0; }
            } else if (behavior === 'explore') {
                if (mouseMoveAccum > 0.008) { behavior = 'follow'; idleTime = 0; }
            }

            var navX, navY;
            if (behavior === 'follow') {
                navX = smoothMouse.x;
                navY = smoothMouse.y;
            } else if (behavior === 'circle') {
                circleAngle += CIRCLE_SPEED * dt;
                if (circleAngle - circleStartAngle > Math.PI * 4) { behavior = 'explore'; pickExploreTarget(); }
                var ccx = THREE.MathUtils.clamp(smoothMouse.x, -0.55, 0.55);
                var ccy = THREE.MathUtils.clamp(smoothMouse.y, -0.55, 0.55);
                navX = ccx + Math.cos(circleAngle) * CIRCLE_RADIUS;
                navY = ccy + Math.sin(circleAngle) * CIRCLE_RADIUS;
            } else {
                exploreTimer += dt;
                var dex = vehicle.pos.x / halfW - exploreTarget.x;
                var dey = vehicle.pos.y / halfH - exploreTarget.y;
                if (Math.sqrt(dex*dex + dey*dey) < 0.15 || exploreTimer > 5.0) { pickExploreTarget(); }
                navX = exploreTarget.x;
                navY = exploreTarget.y;
            }

            var navTarget = new THREE.Vector3(navX * halfW, navY * halfH, 0);
            var result = vehicle.update(navTarget, dt);

            vehicle.applyTo(dolphinGroup);
            dolphinGroup.scale.setScalar(currentScale * 0.5);

            dolphinPos.x = vehicle.pos.x / halfW;
            dolphinPos.y = vehicle.pos.y / halfH;

            animateDolphin(result.speed, dt, result.yawError);

            // Update bubbles
            var bp = bubbleGeo.attributes.position;
            var bs = bubbleGeo.attributes.aSize;
            for (var i = 0; i < BUBBLE_N; i++) {
                bubbleLife[i] += dt;
                if (bubbleLife[i] > BUBBLE_LIFETIME) { resetBubble(i); continue; }
                var t = bubbleLife[i] / BUBBLE_LIFETIME;
                bubblePos[i*3] += (Math.random()-0.5) * 0.002;
                bubblePos[i*3+1] += dt * 0.25;
                bubblePos[i*3+2] += (Math.random()-0.5) * 0.002;
                var fadeIn = Math.min(t * 8.0, 1.0);
                var fadeOut = 1.0 - THREE.MathUtils.smoothstep(t, 0.5, 1.0);
                var grow = 1.0 + t * 2.0;
                bubbleSizes[i] = fadeIn * fadeOut * grow * currentScale;
            }
            bp.needsUpdate = true;
            bs.needsUpdate = true;

            renderer.render(scene, camera);
        }
        animateLoop();

        // Events
        window.addEventListener('mousemove', function(e) {
            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
        });

        window.addEventListener('touchmove', function(e) {
            var touch = e.touches[0];
            if (touch) {
                mouse.x = (touch.clientX / window.innerWidth) * 2 - 1;
                mouse.y = -(touch.clientY / window.innerHeight) * 2 + 1;
            }
        }, { passive: true });

        window.addEventListener('resize', function() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
            bubbleShader.uniforms.uScale.value = window.innerHeight;
        });

        return {
            toggle: function() {
                dolphinEnabled = !dolphinEnabled;
                targetScale = dolphinEnabled ? 1 : 0;
                if (dolphinEnabled) {
                    renderer.domElement.style.display = 'block';
                    var vis = getVisibleHalfSize();
                    vehicle.reset();
                    vehicle.pos.set(mouse.x * vis.halfW, mouse.y * vis.halfH, 0);
                    dolphinPos.set(mouse.x, mouse.y);
                    smoothMouse.set(mouse.x, mouse.y);
                    behavior = 'follow';
                }
            }
        };
    }
})();
</script>
