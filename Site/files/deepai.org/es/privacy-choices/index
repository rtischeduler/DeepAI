/* Toggle Items */
.toggle-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #e5e5e5;
  gap: 16px;
}

.toggle-item:last-of-type {
  border-bottom: none;
}

.toggle-info {
