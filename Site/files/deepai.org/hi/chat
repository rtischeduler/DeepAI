                        if (window.user_object.userprofile2.locked_out_due_to_no_payment_info === false) {
                            window.user_paid_for_no_ads = true;
                        }
                    }
                }
            } catch(e) {
                console.log('error checking user login for ads removal', e);
                // Safety fallback
                window.user_object = undefined;
