            // This prevents "ReferenceError: user_object is not defined"
            window.user_paid_for_no_ads = false;
            window.user_object = undefined;

            try {
                var storedUser = localStorage.getItem('user');
                // check if storedUser is valid string and not "undefined"
                if (storedUser && storedUser !== "undefined") {
                    window.user_object = JSON.parse(storedUser);

                    // Stamp the cached login state on <html> before first paint so the
                    // header renders logged-in on the first frame instead of shifting
                    // once base.ts runs. The server sync later corrects a stale cache.
                    if (window.user_object && window.user_object.pk) {
