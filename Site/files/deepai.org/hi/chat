    <div id="chat-memory-status" class="chat-memory-status" role="status"></div>
    <div class="chat-memory-actions">
      <button id="chat-memory-refresh" type="button">चैट से रीफ़्रेश करें</button>
      <button id="chat-memory-clear" type="button" class="chat-memory-clear">साफ़ करें</button>
    </div>
  </div>
</div>


