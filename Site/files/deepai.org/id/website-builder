                // Check dismissal status
                if (dismissedData) {
                    try {
                        const dismissedDate = new Date(JSON.parse(dismissedData).date);
                        const daysSinceDismissal = Math.floor((Date.now() - dismissedDate) / (1000 * 60 * 60 * 24));
                        if (daysSinceDismissal < 5) {
                            return;
                        }
                    } catch (e) {}
                }

                // Show the banner
