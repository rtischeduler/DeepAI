<main id="website-builder-projects" data-can-build="false" data-authed="false">
  <style>
    /* Atkinson Hyperlegible, self-hosted — no external request at runtime. */
    @font-face {
      font-family: "Atkinson Hyperlegible";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("/static/fonts/atkinson-400.woff2") format("woff2");
    }

    @font-face {
      font-family: "Atkinson Hyperlegible";
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url("/static/fonts/atkinson-700.woff2") format("woff2");
    }

    /* Design tokens ported from the redesign prototype. The site default is
       dark (base.html always stamps html[data-theme]), so dark tokens sit on
       the bare selector and the near-white "paper" set flips in under
       html[data-theme="light"]. */
    /* ==================================================================
       THE SHARED TOKEN SET — one definition, two pages.

       The landing draws the crayon rectangle and the editor receives it:
       projects.ts paints the ghost panel from the LANDING's computed
       --wb-panel / --wb-rule / --wb-shadow-open (projects.ts:277-284) and
       the editor's card then takes over wearing its own. Any token on both
       sides of that handoff has to be one value or the swap has a seam, and
       while these lived in two files the only thing keeping them equal was
       someone remembering to edit both. They diverged: --wb-panel was
       #181331 here and #151130 there, so the ghost was 3/255 red off the
       card it became. That is why this file exists — not tidiness. Included
       from editor.html and projects.html; nothing else may define these.

       WHAT BELONGS HERE: a token both pages use AND must agree on.
       WHAT DOES NOT: a token only one page uses, or one the two pages
       legitimately disagree about (--wb-shadow-rest — the two pages carry
       two different, separately measured anti-banding stacks; unifying it
       is a design decision, not an extraction). Those stay in the page.
       ================================================================== */
    #website-builder-editor,
    #website-builder-projects,
    #website-builder-try {
      /* dark surfaces carry the site gradient's purple-navy cast
         (body fades #170a2d → #010311 under the header) */
      --wb-paper: #0A061D;
      /* sunk surfaces sit a clear step above the near-black gradient — the
         composer pill was disappearing into it */
      --wb-paper-sunk: #181331;
      /* the raised surface the crayon's ghost wears and the editor's card
         inherits — the handoff fill, so it is the editor's value */
      --wb-panel: #151130;
      --wb-ink: #F4F2F9;
      --wb-ink-soft: #918BAB;
      --wb-rule: #332A58;
      /* accents come from the DeepAI brand ramp: #7000FF → #8F37FF → #C549FE */
      --wb-focus: #8F37FF;
      --wb-key-bg: #8F37FF;
      --wb-key-bg-hover: #9D4FFF;
      --wb-key-fg: #FFFFFF;
      --wb-send-off: #332A58;
      --wb-send-off-fg: #8D87B0;

      /* blue through orchid — the slice, not the rainbow */
      --wb-s1: #7000FF;
      --wb-s2: #8F37FF;
      --wb-s3: #AA3DFE;
      --wb-s4: #C549FE;

      /* ONE shadow from the crayon's rectangle through to the finished
         page. Ambient light, not light cast from above: zero offset on
         every layer, equal blur, stepped spread, so the falloff reads as a
         gradient and not as one blur with an edge. Low alpha on purpose —
         deep wide shadows over the near-black page gradient band visibly. */
      --wb-shadow-open:
        0 0 2px rgba(0, 0, 0, 0.34),
        0 0 16px -3px rgba(0, 0, 0, 0.30),
        0 0 40px -10px rgba(0, 0, 0, 0.34);

      /* The landing ghost, editor ghost and real preview card are one visual
         object during handoff, so their shadow must be one shared token. The
         darker workspace needs a shorter, deeper falloff than generic open
         panels; keeping that choice here lets both documents resolve the same
         pixels before and after the in-place landing swap. */
      --wb-stage-shadow:
        0 0 5px rgba(0, 0, 0, 0.95),
        0 0 34px -3px rgba(0, 0, 0, 0.85),
        0 0 96px -18px rgba(0, 0, 0, 0.92);

      --wb-ease-flat: cubic-bezier(0.3, 0.9, 0.25, 1);
      --wb-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui,
                 "Helvetica Neue", Arial, sans-serif;
      --wb-display: "Atkinson Hyperlegible", -apple-system, BlinkMacSystemFont,
                    "Segoe UI", system-ui, sans-serif;
    }

    /* Only the tokens that actually flip. --wb-s1..s4, the eases and the
       families are theme-independent and are inherited from the block
       above by the cascade — restating them here would be a second copy
       of a value, which is the thing this file exists to prevent. */
    html[data-theme="light"] #website-builder-editor,
    html[data-theme="light"] #website-builder-projects,
    html[data-theme="light"] #website-builder-try {
      /* DeepAI dashboard light: lavender paper, slate-purple ink, #7E2FE3 accent */
      --wb-paper: #F5F2FA;
      --wb-paper-sunk: #FFFFFF;
      --wb-panel: #FFFFFF;
      --wb-ink: #33314A;
      --wb-ink-soft: #767194;
      --wb-rule: #E6E1F0;
      --wb-focus: #7E2FE3;
      --wb-key-bg: #7E2FE3;
      --wb-key-bg-hover: #8F37FF;
      --wb-key-fg: #FFFFFF;
      --wb-send-off: #DFDAEC;
      --wb-send-off-fg: #9A94B4;
      /* Paper bands too: the old light open crossed TWO 8-bit steps in a
         single device pixel. Same stepped idiom as dark, alphas re-measured
         against near-white. */
      --wb-shadow-open:
        0 0 2px rgba(51, 49, 74, 0.05),
        0 0 16px -3px rgba(51, 49, 74, 0.07),
        0 0 40px -10px rgba(51, 49, 74, 0.10);
      --wb-stage-shadow: var(--wb-shadow-open);
    }

    /* Keep the original one-screen background behind the hero. Otherwise the
       extra page height stretches the base gradient and changes its colors.
       The light theme's !important background shorthand requires matching
       importance on these longhands. The editor swap removes these rules. */
    body:has(#website-builder-projects) {
      background-size: 100% 100vh !important;
      background-repeat: no-repeat !important;
      background-color: #010311 !important;
    }
    html[data-theme="light"] body:has(#website-builder-projects) {
      background-color: #f0ecf5 !important;
    }
    /* The cue sits in the hero's existing bottom padding, preserving the
