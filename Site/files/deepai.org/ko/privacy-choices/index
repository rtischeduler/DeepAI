  color: white;
  flex: 1;
}

.btn-primary:hover {
  background: #2563eb;
}

.btn-primary:disabled {
  background: #93c5fd;
  cursor: not-allowed;
}

.btn-secondary {
  background: white;
  color: #1a1a1a;
  border: 1px solid #d1d5db;
  flex: 1;
}

.btn-secondary:hover {
  background: #f9fafb;
}

.btn-outline {
  background: white;
  color: #1a1a1a;
  border: 1px solid #d1d5db;
  padding: 8px 16px;
  font-size: 13px;
}

.btn-outline:hover {
  background: #f9fafb;
}

/* Data Rights */
.data-right-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #e5e5e5;
}

.data-right-item:last-child {
  border-bottom: none;
}

.data-right-item h4 {
  font-size: 13px;
  font-weight: 500;
  color: #1a1a1a;
}

/* GPC Info */
.gpc-info {
  background: #fef3c7;
  padding: 10px 12px;
  border-radius: 6px;
  margin: 12px 0;
  font-size: 12px;
}

.gpc-detail {
  padding: 12px;
  font-size: 12px;
  line-height: 1.5;
  background: #f9f9f9;
  border-left: 3px solid #e5e5e5;
  margin-bottom: 8px;
}

.gpc-detail:last-child {
  margin-bottom: 0;
}

.gpc-detail strong {
  display: block;
  margin-bottom: 6px;
  color: #1a1a1a;
  font-size: 13px;
}

/* Legal Links */
.legal-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}

.legal-links a {
  color: #3b82f6;
  text-decoration: none;
