    /* Privacy Modal - Comprehensive Design */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  height: 100%;
  overflow: hidden;
}

body {
  height: 100%;
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  color: #1a1a1a;
  background: white;
  overflow-y: auto;
  overflow-x: hidden;
}

.privacy-container {
  width: 100%;
  padding: 24px;
  min-height: 100%;
}

/* Header */
.privacy-header {
  margin-bottom: 16px;
}

.privacy-header h1 {
  font-size: 24px;
  font-weight: 600;
  margin-bottom: 4px;
  color: #1a1a1a;
}

.privacy-header .subtitle {
  font-size: 13px;
  color: #666;
  font-weight: normal;
}

/* Loading State */
.loading-state {
  text-align: center;
  padding: 40px 20px;
}

.spinner {
  border: 3px solid #f3f3f3;
  border-top: 3px solid #3b82f6;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  animation: spin 1s linear infinite;
  margin: 0 auto 16px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Main Content */
#main-content {
  flex: 1;
}

.intro-text {
  margin-bottom: 16px;
  font-size: 13px;
  color: #444;
  line-height: 1.6;
}

/* Collapsible Sections */
.section-collapse {
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  margin-bottom: 12px;
  background: #f9f9f9;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  cursor: pointer;
  user-select: none;
  font-weight: 600;
  font-size: 14px;
  list-style: none;
}

.section-header::-webkit-details-marker {
  display: none;
}

.section-title {
  flex: 1;
}

.collapse-arrow {
  font-size: 12px;
  transition: transform 0.2s;
}

details[open] .collapse-arrow {
  transform: rotate(180deg);
}

.section-content {
  padding: 0 16px 16px 16px;
  font-size: 13px;
}

.section-intro {
  margin-bottom: 12px;
  color: #666;
}

/* Essential Items */
.essential-item {
  padding: 10px 0;
  border-bottom: 1px solid #e5e5e5;
}

.essential-item:last-child {
  border-bottom: none;
}

.essential-item h4 {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 4px;
  color: #1a1a1a;
}

.essential-item p {
  font-size: 12px;
  color: #666;
}

/* Privacy Choices Section */
.privacy-choices-section {
  margin-bottom: 12px;
}

.privacy-choices-section h2 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 12px;
  color: #1a1a1a;
}

.data-choice-notice {
  background: #f5f5f5;
  padding: 12px;
  border-radius: 6px;
  margin-bottom: 16px;
  font-size: 12px;
}

.data-choice-notice strong {
  display: block;
  margin-bottom: 4px;
  color: #1a1a1a;
}

.data-choice-notice p {
  color: #666;
  margin: 0;
  line-height: 1.5;
}

/* Toggle Items */
.toggle-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #e5e5e5;
  gap: 16px;
}

.toggle-item:last-of-type {
  border-bottom: none;
}

.toggle-info {
  flex: 1;
}

.toggle-info h3 {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 4px;
  color: #1a1a1a;
}

.toggle-info p {
  font-size: 12px;
  color: #666;
  line-height: 1.4;
}

/* Toggle Switch */
.toggle-switch {
  position: relative;
  display: inline-block;
  width: 48px;
  height: 28px;
  flex-shrink: 0;
}

.toggle-switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ccc;
  transition: 0.3s;
  border-radius: 28px;
}

.slider:before {
  position: absolute;
  content: "";
  height: 22px;
  width: 22px;
  left: 3px;
  bottom: 3px;
  background-color: white;
  transition: 0.3s;
  border-radius: 50%;
}

input:checked + .slider {
  background-color: #3b82f6;
}

input:checked + .slider:before {
  transform: translateX(20px);
}

input:disabled + .slider {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  gap: 8px;
  margin-top: 16px;
}

/* Buttons */
.btn-primary,
.btn-secondary,
.btn-outline {
  padding: 10px 20px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  border: none;
  transition: all 0.2s;
}

.btn-primary {
