        <script>
            function toggleTheme() {
                var html = document.documentElement;
                var current = html.getAttribute('data-theme');
                var next = current === 'light' ? 'dark' : 'light';
                html.classList.add('theme-transition');
                html.setAttribute('data-theme', next);
                try { localStorage.setItem('deepai-theme', next); } catch(e) {}
                try { if (typeof window.recordThemeToggle === 'function') window.recordThemeToggle(current, next); } catch(e) {}
                var btn = document.getElementById('themeToggleBtn');
                if (btn) btn.setAttribute('aria-pressed', next === 'light' ? 'true' : 'false');
                setTimeout(function(){ html.classList.remove('theme-transition'); }, 350);
            }
        </script>
